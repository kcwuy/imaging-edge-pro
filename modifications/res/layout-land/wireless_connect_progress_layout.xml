<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@id/wireless_connect_progress_layout" android:visibility="gone"
 android:background="#fff7f7f4" android:layout_width="match_parent" android:layout_height="match_parent"
 android:clickable="true" android:focusable="true" android:padding="16dp">
 <TextView android:id="@id/wireless_cancel_btn" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:minHeight="48dp" android:layout_alignParentBottom="true" android:gravity="center" android:padding="10dp"
  android:text="取消连接" android:textSize="14sp" android:textColor="#ff181919" android:fontFamily="sans-serif-medium" />
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/wireless_cancel_btn" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
   <ImageView android:layout_width="140dp" android:layout_height="120dp" android:padding="28dp" android:src="@android:drawable/ic_menu_camera" android:tint="#ff293324" android:contentDescription="正在连接相机" android:scaleType="fitCenter" />
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在建立连接。" android:textSize="24sp" android:textColor="#ff181919" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="连接相机专用网络并确认会话。无需互联网。" android:textSize="12sp" android:textColor="#ff70716f" android:lineSpacingExtra="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp" android:minHeight="38dp">
     <ImageView android:id="@id/wireless_network_search_phase" android:layout_width="24dp" android:layout_height="24dp" android:visibility="invisible" android:src="@drawable/ic_check_circle" android:tint="#ff258658" />
     <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="查找相机" android:textSize="13sp" android:textColor="#ff4f5b47" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="38dp">
     <ImageView android:id="@id/wireless_network_connect_phase" android:layout_width="24dp" android:layout_height="24dp" android:visibility="invisible" android:src="@drawable/ic_check_circle" android:tint="#ff258658" />
     <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="连接相机 Wi-Fi" android:textSize="13sp" android:textColor="#ff4f5b47" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="38dp">
     <ImageView android:id="@id/wireless_camera_connect_phase" android:layout_width="24dp" android:layout_height="24dp" android:visibility="invisible" android:src="@drawable/ic_check_circle" android:tint="#ff258658" />
     <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="确认相机会话" android:textSize="13sp" android:textColor="#ff4f5b47" />
    </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
</RelativeLayout>
